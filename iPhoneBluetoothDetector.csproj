<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target the Windows 10.0.19041 SDK so the WinRT Bluetooth LE
         advertisement APIs (Windows.Devices.Bluetooth.Advertisement) are available. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>iPhoneBluetoothDetector</RootNamespace>
    <AssemblyName>iPhoneBluetoothDetector</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Microsoft security / quality standards -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Do not emit a build that silently trusts unsigned assemblies at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
